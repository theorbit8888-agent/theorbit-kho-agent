# Mẫu env cho agent kho. Bản thật ở ~/.config/orbit-kho/lark.env (KHÔNG commit, không gửi ai).
# Team dev: copy file này ra ~/.config/orbit-kho-test/lark.env, điền đồ THỬ của mình, chạy với
#   ORBIT_KHO_ENV=~/.config/orbit-kho-test/lark.env .venv/bin/python tools/listener.py
TELEGRAM_BOT_TOKEN=     # bot thử riêng (tạo bằng @BotFather), KHÔNG dùng token bot thật
CHAT_ID=                # nhóm Kho thử (chạy tools/tim-nhom.py hoặc xem log để lấy id)
TICKET_CHAT_ID=         # nhóm Đổi trả thử
CH_CHAT_ID=             # nhóm CS & Cửa hàng thử
OWNER_TELE_ID=          # Telegram id của chính bạn (để nhận tin "chủ shop")
KHO_URL=                # link Web App Apps Script của Google Sheet THỬ (bản copy)
KHO_SECRET=             # mã bí mật đặt trong Apps Script của Sheet thử
APP_ID=                 # Lark app (chỉ cần nếu sửa phần đọc Lark Base)
APP_SECRET=
LARK_CHAT_ID=
# Tuỳ chọn: TICKET_DUYET_IDS, PHI_SHIP, NGUONG_DUYET, QUA_HAN_HOAN
